########## smooth Wayland protocols list ##########

# Wayland protocols used by smooth, relative to the data directory of
# wayland-protocols. Header and object file names are derived from
# this list by the makefiles including it.

WAYLAND_PROTOCOLS      = stable/xdg-shell/xdg-shell.xml \
			 unstable/primary-selection/primary-selection-unstable-v1.xml \
			 staging/xdg-toplevel-icon/xdg-toplevel-icon-v1.xml \
			 stable/viewporter/viewporter.xml \
			 unstable/xdg-output/xdg-output-unstable-v1.xml

WAYLAND_PROTOCOL_NAMES = $(basename $(notdir $(WAYLAND_PROTOCOLS)))
